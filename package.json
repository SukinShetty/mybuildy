{
  "name": "mybuildy",
  "productName": "MyBuildy",
  "version": "0.1.0",
  "description": "MyBuildy: an AI builder companion that watches your Claude Code terminal and tells non-technical builders what happened and what to type next.",
  "author": "Sukin Shetty",
  "homepage": "https://github.com/SukinShetty/mybuildy",
  "license": "PolyForm-Shield-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/SukinShetty/mybuildy.git"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:packaged": "node scripts/e2e-packaged.mjs",
    "fetch:voice": "node scripts/fetch-kokoro-model.mjs"
  },
  "dependencies": {
    "nemp-mcp-server": "^0.2.2",
    "onnxruntime-node": "1.21.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@huggingface/transformers": "3.8.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "kokoro-js": "1.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.5.0",
    "vite": "^7.3.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.solutionforgelabs.mybuildy",
    "productName": "MyBuildy",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/kokoro",
        "to": "kokoro"
      }
    ],
    "afterPack": "scripts/after-pack.js",
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "MyBuildy-Setup-${version}.exe",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "MyBuildy uses the microphone only when you click the mic to ask a question.",
        "NSAppleEventsUsageDescription": "MyBuildy asks System Events to bring your terminal to the front and press Cmd+V when you click Paste into terminal. It never presses Return."
      },
      "signIgnore": [
        "Contents/Resources/kokoro/"
      ]
    },
    "dmg": {
      "artifactName": "MyBuildy-${version}-${arch}.${ext}",
      "sign": true
    },
    "publish": null,
    "asarUnpack": [
      "node_modules/onnxruntime-node/**"
    ]
  },
  "overrides": {
    "@electron/osx-sign": {
      "isbinaryfile": "5.0.7"
    }
  }
}
